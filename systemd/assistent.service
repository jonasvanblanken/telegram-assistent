[Unit]
Description=Persönlicher Assistent in Telegram (pearl-kit)
After=network-online.target google-mcp.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/pearl-kit/assistent.py
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=10
MemoryMax=1500M

[Install]
WantedBy=default.target
